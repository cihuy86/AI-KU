<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.droidai.assistant">

    <!-- 1. Izin Overlay Melayang (Floating Robot) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 2. Izin Perekaman / Tangkapan Layar (MediaProjection) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- 3. Izin Kamera untuk Scan Lembar Soal Fisik -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 4. Izin Rekam Suara untuk Perintah Vokal ke Gemini -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 5. Izin Internet & Jaringan untuk Komunikasi API Gemini -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DroidAiApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DroidAI"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- Activity Utama (Jetpack Compose UI) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DroidAI"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity Scan Kamera untuk Soal Kertas -->
        <activity
            android:name=".ui.CameraScanActivity"
            android:exported="false"
            android:theme="@style/Theme.DroidAI" />

        <!-- 6. Accessibility Service untuk Navigasi & Auto-Tap Otonom -->
        <service
            android:name=".service.AutonomousAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Layanan Overlay Robot Melayang (Window Manager) -->
        <service
            android:name=".service.FloatingOverlayService"
            android:exported="false" />

        <!-- Layanan Screen Capture (MediaProjection Foreground Service) -->
        <service
            android:name=".service.ScreenCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

    </application>
</manifest>